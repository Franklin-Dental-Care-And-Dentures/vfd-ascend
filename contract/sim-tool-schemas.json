      "visit_kind": {
       "type": "string",
       "enum": [
        "new_patient",
        "limited",
        "filling",
        "extraction",
        "cleaning",
        "srp",
        "crown",
        "partial",
        "denture",
        "seat",
        "delivery"
       ]
      },
