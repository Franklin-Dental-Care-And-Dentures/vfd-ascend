      },
      "phone": {
       "type": "string",
       "description": "10 digits"
      }
     },
     "required": [],
     "additionalProperties": false
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "strike_count",
    "description": "A patient's strikes (No Show and Broken), the count in force and whether booking is refused. 12 months with no new strike is a clean slate.",
